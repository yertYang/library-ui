{
  "name": "@library/ui",
  "version": "0.1.0",
  "description": "Reusable React and Taro UI components for mini programs and H5.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.scss": "./styles/index.scss",
    "./theme.scss": "./styles/theme.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "styles",
    "README.md"
  ],
  "sideEffects": [
    "**/*.scss"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.cjs",
    "check:styles": "node scripts/check-styles.cjs",
    "check": "npm run typecheck && npm test && npm run check:styles"
  },
  "peerDependencies": {
    "@tarojs/components": "^4.2.1",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@tarojs/components": "4.2.1",
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "sass": "^1.75.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/yertYang/library-ui.git"
  },
  "bugs": {
    "url": "https://github.com/yertYang/library-ui/issues"
  },
  "homepage": "https://github.com/yertYang/library-ui#readme"
}
